# Environment Configuration Template (Zero Trust Security)
# Salin file ini menjadi .env saat konfigurasi tahap implementasi.
# PERINGATAN: Jangan pernah mencantumkan nilai secret produksi asli di sini.

# Gateway Configuration
GATEWAY_PORT=3000
NODE_ENV=development

# Resource Services Ports
SERVICE_NILAI_PORT=3001
SERVICE_TRANSKRIP_PORT=3002

# Internal Security Secrets (Gunakan random string panjang di .env lokal)
GATEWAY_SECRET=change-this-to-a-strong-random-gateway-secret
JWT_SECRET=change-this-to-a-strong-random-jwt-secret

# Operational Time Window Configuration (Format 24 jam)
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21

# Database Configuration
DATABASE_PATH=./data/database.sqlite
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=change-this-to-a-strong-service-secret
